# Скрипты установки (preinstall, install, postinstall) не выполняются ни у
# зависимостей, ни у самого проекта, на любой версии npm: чужой код при
# установке не запускается. Свои шаги после установки — явно:
#   npm ci && npm run postinstall --if-present
ignore-scripts=true
# Выдержка новых версий: npm не ставит пакеты, выпущенные меньше 7 дней назад
# (npm 12+; старые версии npm предупреждают о незнакомой настройке).
min-release-age=7
